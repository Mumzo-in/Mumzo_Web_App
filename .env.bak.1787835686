# Single source of truth for the whole monorepo.
#
# Every workspace reads this one file:
#   - server / scripts  → dotenv, via packages/env (walks up to the repo root)
#   - vite apps         → envDir points here; only VITE_* reach the browser
#   - drizzle-kit       → packages/db/drizzle.config.ts
#   - docker compose    → infra/docker-compose.yml
#
# Gitignored. Copy .env.example to create it.

# --- Database ---------------------------------------------------------------
# Host is `localhost` from the host machine, `postgres` inside compose.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mumzo
# DB_SUPABASE_PASS=NWzWRy6jLKmxne9p
DATABASE_URL="postgresql://postgres.pltlbuqcmkvczohlvzge:NWzWRy6jLKmxne9p@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"
# Direct connection (no PgBouncer) — used by db:migrate to avoid silent DDL failures.
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_DIRECT_URL="postgresql://postgres:NWzWRy6jLKmxne9p@db.pltlbuqcmkvczohlvzge.supabase.co:5432/postgres"

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10
DATABASE_SSL=false

# --- Postgres container -----------------------------------------------------
# NOTE: docker compose interpolates ${POSTGRES_*} relative to infra/, so it
# reads infra/.env — NOT this file. These are kept here only so the intended
# values live in one place; change infra/.env to actually affect the container,
# and keep both consistent with DATABASE_URL above.
POSTGRES_DB=mumzo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Auth -------------------------------------------------------------------
BETTER_AUTH_SECRET=2miArRIZU9cesii83bO1QWhIqxBXUb4v
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated. Storefront (3001) and admin (3002) are separate origins.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Public storefront URL — used to redirect real browsers away from
# server-rendered crawler share pages (e.g. /r/:code).
PLATFORM_URL=http://localhost:3001

# "111111" verifies for any phone number when true. Local/staging only — never in production.
OTP_BYPASS=true

# --- Cloudflare R2 -----------------------------------------------------------
R2_ENDPOINT=https://010df2be25894c6bc4a03e47952e331c.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=34910cbc3554543485eb115e720db63c
R2_SECRET_ACCESS_KEY=30f2c674a223bb82e8cdc4830dba258326f16517f30b56bbe1681ccda06986a1
R2_PUBLIC_BUCKET=mumzo
R2_PRIVATE_BUCKET=mumzo
# TODO: replace with the real pub-<hash>.r2.dev URL from the bucket's Public Access settings
R2_PUBLIC_URL=https://pub-a6e7d5126ea74fd99f9abac70da54bc6.r2.dev

# --- Upload processing --------------------------------------------------------
R2_MAX_UPLOAD_MB=20
R2_RESIZE_THRESHOLD_MB=1
R2_ENABLE_CDN_RESIZE=false
R2_IMAGE_MAX_DIMENSION=2048
R2_IMAGE_QUALITY=82

# --- Frontend ---------------------------------------------------------------
# Only VITE_* variables are exposed to browser bundles. Never put a secret
# behind this prefix — it ships to every visitor.
VITE_SERVER_URL=http://localhost:3000


