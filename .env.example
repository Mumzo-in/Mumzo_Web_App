# Single source of truth for the whole monorepo.
#
# Every workspace reads this one file:
#   - server / scripts  → dotenv, via packages/env (walks up to the repo root)
#   - vite apps         → envDir points here; only VITE_* reach the browser
#   - drizzle-kit       → packages/db/drizzle.config.ts
#   - docker compose    → infra/docker-compose.yml
#
# Gitignored. Copy .env.example to create it.

# --- Database ---------------------------------------------------------------
# Host is `localhost` from the host machine, `postgres` inside compose.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mumzo

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10
DATABASE_SSL=false

# --- Postgres container -----------------------------------------------------
# NOTE: docker compose interpolates ${POSTGRES_*} relative to infra/, so it
# reads infra/.env — NOT this file. These are kept here only so the intended
# values live in one place; change infra/.env to actually affect the container,
# and keep both consistent with DATABASE_URL above.
POSTGRES_DB=mumzo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-minimum-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated. Storefront (3001) and admin (3002) are separate origins.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# --- Frontend ---------------------------------------------------------------
# Only VITE_* variables are exposed to browser bundles. Never put a secret
# behind this prefix — it ships to every visitor.
VITE_SERVER_URL=http://localhost:3000
