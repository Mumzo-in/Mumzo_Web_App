# Copy to infra/.env to override the compose defaults.
#
#   cp infra/.env.example infra/.env
#
# Every value here has a default in docker-compose.yml, so this file is
# optional — you need it only to change a port or the password. Whatever you
# set must stay consistent with DATABASE_URL in apps/server/.env.

POSTGRES_DB=mumzo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Change if 5432 is already taken on the host (e.g. a system Postgres).
POSTGRES_PORT=5432

# Host port for the optional server overlay.
SERVER_PORT=3000
