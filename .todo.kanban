    {
      "id": "0f886534-0621-474c-a56c-800722b65f4a",
      "title": "Doing",
      "cards": [
        {
          "id": "e3a71e37-8edc-4279-8cf2-d4cd168a649d",
          "listId": "0f886534-0621-474c-a56c-800722b65f4a",
          "title": "Dynamic roles & permissions (admin)",
          "description": "Move role→permission assignments from code into the database, seeded with the six roles we already have.\n\nWHY NOW: permissions are defined in three places and enforced in NONE — grep for hasPermission returns nothing across both apps. Every signed-in staff member can do everything.\n\nCONSTRAINT: Better Auth's admin plugin cannot do dynamic roles. Its has-permission is nine synchronous lines reading an in-memory config; dynamicAccessControl exists only in the organization plugin. So: our own tables, our own middleware.\n\nResources/actions stay in code (they are only real because code implements them). Role grants become data.",
          "labels": [
            {
              "id": "6e595134-aa80-409b-8a66-3bd9f16f0771",
              "title": "admin",
              "color": "#3f6fb5"
            },
            {
              "id": "84019607-9894-4e13-a93f-2a5bf7ab4d60",
              "title": "backend",
              "color": "#c9822f"
            },
            {
              "id": "91758be0-4629-457c-95ab-10b86734a297",
              "title": "epic:superadmin",
              "color": "#1f1b3a"
            }
          ],
          "checkboxes": [
            {
              "id": "d58077a9-8cfa-4a1c-9219-22ce64a240b1",
              "text": "staff_role + staff_role_permission tables + migration",
              "checked": false
            },
            {
              "id": "a19f2c6e-27f6-4b6a-b597-e5ab0e3791ba",
              "text": "Seed the six roles from the existing matrix (idempotent)",
              "checked": false
            },
            {
              "id": "502008c3-45b5-44f6-a7ba-a623177577db",
              "text": "requirePermission(resource, action) middleware + cached resolution",
              "checked": false
            },
            {
              "id": "980fe8f5-1231-42ea-a5d2-513d23d54639",
              "text": "Roles CRUD API under /api/v1/admin/roles",
              "checked": false
            },
            {
              "id": "6f8762e6-9923-4bf2-9f23-ccd7040d08b3",
              "text": "Delete-protection: system roles, and roles still assigned",
              "checked": false
            },
            {
              "id": "171d7bfc-0a86-4a6a-825d-19f8ec1092fa",
              "text": "Rebuild the roles page on live data (matrix UI)",
              "checked": false
            },
            {
              "id": "e24536fe-6d0e-4e83-82cd-75dd765524e0",
              "text": "usePermission hook + <Can> wrapper to hide actions",
              "checked": false
            },
            {
              "id": "ed2c2264-ce39-48f7-affa-fbcfb2abe3d3",
              "text": "Delete the duplicate roles-permissions.ts in admin",
              "checked": false
            }
          ],
          "comments": []
        }
      ]
    },
