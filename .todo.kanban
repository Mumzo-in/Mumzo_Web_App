        {
          "id": "307fc666-f16e-41d9-8fda-123e0bfc2690",
          "listId": "f699e340-c141-4c20-a8f5-d8a2eac2773a",
          "title": "Cart → Order → Payment",
          "description": "The revenue path. Do it as ONE block, not three — they share the reservation and state-machine invariants, and splitting them is how you get a cancel path that forgets to release stock. The hard part is inventory reservation, order idempotency, and Razorpay webhooks, not the endpoints.",
          "labels": [
            {
              "id": "84019607-9894-4e13-a93f-2a5bf7ab4d60",
              "title": "backend",
              "color": "#c9822f"
