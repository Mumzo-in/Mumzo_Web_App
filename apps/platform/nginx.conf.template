server {
    listen ${PORT};
    server_name localhost;

    # Link-preview crawlers (WhatsApp, iMessage, Slack, Twitter/X) never run
    # this SPA's JS, so they never see the og:* tags injected client-side.
    # The API server renders real HTML with real OG tags at the same path
    # and bounces human visitors straight back into the SPA — proxy to it
    # instead of falling through to index.html.
    location /r/ {
        proxy_pass ${API_ORIGIN}/r/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets (JS, CSS, images) aggressively
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|svg|woff2)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
