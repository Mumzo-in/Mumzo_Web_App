# Copy to .env and fill in. `.env` is gitignored; this file is committed.
#
#   cp apps/server/.env.example apps/server/.env
#   bun db:start

# --- Database ---------------------------------------------------------------
# Must match POSTGRES_* in infra/.env. Host is `localhost` when the API runs on
# the host (the normal dev loop); `postgres` when the API runs inside compose.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mumzo

# Max pooled connections per process. Keep the sum across all running
# processes well under the server's max_connections (100 locally).
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10
# "true" on managed Postgres (Neon/RDS/Supabase); "false" for local Docker.
DATABASE_SSL=false

# --- Server -----------------------------------------------------------------
PORT=3000

# --- Auth -------------------------------------------------------------------
# Min 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-minimum-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated. Storefront and admin run on separate ports.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

NODE_ENV=development
