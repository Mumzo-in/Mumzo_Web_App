{
  "name": "@mumzo/server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@mumzo/auth": "workspace:*",
    "@mumzo/cache": "workspace:*",
