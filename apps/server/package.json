    "@mumzo/env": "workspace:*",
    "@mumzo/notifications": "workspace:*",
    "@mumzo/realtime": "workspace:*",
    "@mumzo/storage": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/hono-api-reference": "^0.11.11",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "hono-rate-limiter": "^0.5.3",
    "satori": "^0.29.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mumzo/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:"
